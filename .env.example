# Server-side (Server Components, route handlers) — never sent to the browser
BACKEND_URL=http://localhost:8000

# Client-side (bundled into the browser) — used by the donation form's fetch calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags mirrored from the backend so the give-page UI can hide rails
# that aren't configured yet (kept in sync manually until credentials exist)
NEXT_PUBLIC_TEST_PROVIDER_ENABLED=true
NEXT_PUBLIC_STRIPE_ENABLED=false
NEXT_PUBLIC_PAYPAL_ENABLED=false
NEXT_PUBLIC_MPESA_ENABLED=false
NEXT_PUBLIC_BTC_ENABLED=false
